{
  "name": "pagdandi",
  "version": "0.1.0",
  "private": true,
  "description": "India's open trek database",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-migrate.ts",
    "treks:validate": "tsx scripts/treks-validate.ts",
    "treks:load": "tsx --conditions=react-server --env-file-if-exists=.env scripts/treks-load.ts",
    "treks:embed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/treks-embed.ts",
    "audio": "tsx --conditions=react-server --env-file-if-exists=.env scripts/make-audio.ts",
    "digest": "tsx --conditions=react-server --env-file-if-exists=.env src/jobs/daily-digest.ts",
    "topo": "tsx scripts/make-topo.ts",
    "devrelay:setup": "bash scripts/devrelay-setup.sh",
    "search:eval": "tsx --conditions=react-server --env-file-if-exists=.env scripts/search-eval.ts",
    "audio:draft": "tsx --conditions=react-server --env-file-if-exists=.env scripts/draft-audio-scripts.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@ai-sdk/react": "4.0.130",
    "@mastra/ai-sdk": "1.10.6",
    "@mastra/core": "1.74.0",
    "@radix-ui/react-slot": "1.3.3",
    "ai": "7.0.127",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "2.70.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
