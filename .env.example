# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: the URL `pnpm dev:up` prints. In production: the Tiger Data service URL.
DATABASE_URL=postgres://pagdandi@127.0.0.1:54329/pagdandi

# Ollama, serving Gemma. Locally: your Ollama. On Render: the private service (set by render.yaml).
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=gemma4:e4b
EMBED_MODEL=embeddinggemma:300m

# Public site URL, used in email links.
SITE_URL=http://localhost:3000

# The only address daily emails reach until the site has its own domain.
ADMIN_EMAIL=

# Email: dry-run writes emails to .data/outbox/ instead of sending them.
EMAIL_MODE=dry-run
EMAIL_FROM=Pagdandi <onboarding@resend.dev>
RESEND_API_KEY=

# News: fixtures uses recorded sample results; serpapi makes real searches (hard-capped).
NEWS_MODE=fixtures
SERPAPI_API_KEY=
SERPAPI_DAILY_CAP=25
SERPAPI_MONTHLY_CAP=200

# Audio generation (scripts/make-audio.ts only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
