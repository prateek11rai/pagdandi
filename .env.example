# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: the URL `pnpm dev:up` prints. With Tiger Data: its service URL (sslmode=require).
DATABASE_URL=postgres://pagdandi@127.0.0.1:54329/pagdandi

# Ollama, serving Gemma on this machine. Chats are sent to it, so a non-loopback address is refused
# unless OLLAMA_ALLOW_REMOTE=true.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=gemma4:e4b
EMBED_MODEL=embeddinggemma:300m

# The site's URL, used in email links.
SITE_URL=http://localhost:3000

# Only behind a reverse proxy that sets X-Forwarded-For. Otherwise all visitors share one rate limit.
TRUST_PROXY=false

# The only address daily emails reach until the site has its own domain.
ADMIN_EMAIL=

# Email: dry-run writes emails to .data/outbox/ instead of sending them. smtp sends them from your own
# mailbox (587 with STARTTLS, or 465 with TLS), and only ever to ADMIN_EMAIL. For Gmail, use an app password.
EMAIL_MODE=dry-run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Set it if the login isn't an address, e.g. Pagdandi <you@example.com>
EMAIL_FROM=

# Forecasts: open-meteo fetches live forecasts; fixtures uses a recorded sample, labelled as such (CI and tests).
FORECAST_MODE=open-meteo

# News: fixtures uses recorded sample results; serpapi makes real searches (hard-capped).
NEWS_MODE=fixtures
SERPAPI_API_KEY=
SERPAPI_DAILY_CAP=25
SERPAPI_MONTHLY_CAP=200

# Audio generation (scripts/make-audio.ts only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
